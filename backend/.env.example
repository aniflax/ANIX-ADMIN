# ---------------------------------------------------------------------------
# anix HRMS — backend environment example
# Copy to `.env` and fill in your own values. Never commit real secrets.
# ---------------------------------------------------------------------------

# Database
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/anix_hrms

# Auth
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# App
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
# For mobile activation links on the same Wi-Fi, set FRONTEND_URL to your
# computer's LAN URL, e.g. http://192.168.1.10:5173

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Database connection pool (keep small on free hosting tiers)
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3

# Document storage — "local" for development, "r2" for Cloudflare R2
STORAGE_PROVIDER=local
GCS_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=

# Outbound email — "smtp" or "brevo"
EMAIL_PROVIDER=smtp
EMAILS_FROM_NAME=anix HRMS
EMAILS_FROM_EMAIL=no-reply@anix-hrms.example
BREVO_API_KEY=

# SMTP settings (used when EMAIL_PROVIDER=smtp)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
